#!/usr/bin/env bashim
# vim: filetype=sh
set -Eeuo pipefail

# Find sibling scripts (filepick, ghostty-reload) even when ~/bin is not on PATH
PATH="$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")"):$PATH"

usage() {
  cat <<'USAGE'
Usage:
  set-ghostty-background [FILE | DIR]

Set the Ghostty background image and reload the config.

  FILE    Use this image as the background
  DIR     Use a random image from this folder (recursive), never the current one
          unless it is the only image there
  (none)  Clear the background image

Options:
  -h, --help  Show this help
USAGE
}

case "${1:-}" in
  -h|--help) usage; exit 0;;
esac

FILE_INPUT="${1:-""}"
TARGET_FILE=${DOTFILES:-$HOME/dotfiles}/ghostty/background.local
FILE_PATH="$FILE_INPUT"

set_background() {
  # resolve to absolute path
  if [[ -d "$1" ]]; then
    # Avoid re-picking the current image, unless it's the only one in the folder
    local current
    current="$(sed -n 's/^background-image = //p' "$TARGET_FILE" 2>/dev/null || true)"
    if [[ -n "$current" ]]; then
      FILE_PATH="$(filepick -q -r -X "$current" "$1" 2>/dev/null || filepick -q -r "$1")"
    else
      FILE_PATH="$(filepick -q -r "$1")"
    fi
    echo "background-image = $FILE_PATH" > "$TARGET_FILE"
  elif [[ -f "$1" ]]; then
    FILE_PATH="$(realpath -- "$1")"
    echo "background-image = $FILE_PATH" > "$TARGET_FILE"
  else
    echo "" > "$TARGET_FILE"
  fi
}

set_background "$FILE_INPUT"
ghostty-reload
